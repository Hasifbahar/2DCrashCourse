      propertyPath: myClueText
      value: '""Clue #4: The else if statement!

        Need more than just two
        choices? Stick an ''else if'' right after your first ''if''! It lets you
        check a brand new condition if the very first one fails.

        Example:
        if (health == 100) { / Full Health! / } else if (health > 0) { / Watch out
        for Slimes! / } else { / Java Hero Defeated! / }""'
      objectReference: {fileID: 0}
